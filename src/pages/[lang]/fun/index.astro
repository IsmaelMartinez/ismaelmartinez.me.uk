---
import Layout from '../../../layouts/Layout.astro';
import ArcadeCabinet from '../../../components/ArcadeCabinet.astro';
import { useTranslations, getLocalizedPath, locales } from '../../../i18n/translations';
import type { Locale, TranslationKey } from '../../../i18n/translations';
import { UNLOCK_CHAIN } from '../../../games/engine/progress';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

interface ArcadeGame {
  id: (typeof UNLOCK_CHAIN)[number];
  title: string;
  taglineKey: TranslationKey;
  genreKey: TranslationKey;
  twoPlayer: boolean;
  icon: string;
  color: string;
  path: string;
}

// The floor is under construction: cabinets stand in UNLOCK_CHAIN order and
// are revealed one at a time (see src/games/engine/progress.ts). The old
// Featured / Back-catalogue shelves are retired with it.
//
// Pixel Park is parked: its ride graphics need more work before it ships, so
// we're stabilising the other cabinets first. Its cabinet is off the floor
// AND its page is unpublished — renamed to the unrouted
// src/pages/[lang]/fun/_park.astro, so no /fun/park route is built. The game
// under src/games/park/ stays in the repo. To bring it back for a future
// release: rename _park.astro back to park.astro and re-add an entry here.
//
// Syndicate is parked the same way (2026-08-11): it sat outside the unlock
// chain while the floor is rebuilt, so its cabinet is off the floor AND its
// page is unpublished — renamed to the unrouted
// src/pages/[lang]/fun/_syndicate.astro, so no /fun/syndicate route is built.
// The game under src/games/syndicate/ stays in the repo. To bring it back:
// rename _syndicate.astro back to syndicate.astro, re-add an entry here, and
// slot it into the unlock chain in progress.ts.
const cabinetArt: Record<(typeof UNLOCK_CHAIN)[number], Omit<ArcadeGame, 'id'>> = {
  towerdefense: {
    title: 'LINE HOLD',
    taglineKey: 'fun.towerdefense.description',
    genreKey: 'fun.arcade.genre.towerdefense',
    twoPlayer: false,
    icon: '🏰',
    color: '#f59e0b',
    path: '/fun/towerdefense'
  },
  lemmings: {
    title: 'CRITTER RESCUE',
    taglineKey: 'fun.lemmings.description',
    genreKey: 'fun.arcade.genre.lemmings',
    twoPlayer: false,
    icon: '🐛',
    color: '#84cc16',
    path: '/fun/lemmings'
  },
  cascade: {
    title: 'CASCADE',
    taglineKey: 'fun.cascade.description',
    genreKey: 'fun.arcade.genre.cascade',
    twoPlayer: false,
    icon: '🧱',
    color: '#a855f7',
    path: '/fun/cascade'
  },
  city: {
    title: 'MICROCITY',
    taglineKey: 'fun.city.description',
    genreKey: 'fun.arcade.genre.city',
    twoPlayer: false,
    icon: '🏙️',
    color: '#38bdf8',
    path: '/fun/city'
  },
  tanks: {
    title: 'TANK DUEL',
    taglineKey: 'fun.tanks.description',
    genreKey: 'fun.arcade.genre.tanks',
    twoPlayer: true,
    icon: '🎯',
    color: '#3b82f6',
    path: '/fun/tanks'
  },
  snake: {
    title: 'SNAKE',
    taglineKey: 'fun.snake.description',
    genreKey: 'fun.arcade.genre.snake',
    twoPlayer: false,
    icon: '🐍',
    color: '#14b8a6',
    path: '/fun/snake'
  }
};

// One cabinet per chain link, in unlock order.
const arcadeGames: ArcadeGame[] = UNLOCK_CHAIN.map(id => ({ id, ...cabinetArt[id] }));
---

<Layout title="The Arcade" lang={lang}>
  <div class="arcade-room">
    <div class="neon-grid"></div>

    <div class="arcade-header">
      <h1 class="neon-sign">
        <span class="neon-text">ISMAEL'S</span>
        <span class="neon-text accent">ARCADE</span>
      </h1>
      <p class="arcade-subtitle">{t('fun.arcade.subtitle')}</p>
    </div>

    <div class="dust-sign">
      <div class="tape-line" aria-hidden="true"></div>
      <p>{t('fun.arcade.wip.sign')}</p>
      <div class="tape-line" aria-hidden="true"></div>
    </div>

    <div class="arcade-floor">
      <div class="cabinets-row">
        {/*
          The whole chain is rendered and toggled client-side, since unlock
          state lives in this device's localStorage. Server defaults match a
          first visit (and no-JS): the first cabinet on, the second shrouded.
        */}
        {arcadeGames.map((game, i) => (
          <>
            {i > 0 && (
              <div class="locked-cabinet" data-shroud={game.id} hidden={i !== 1}>
                <div class="shroud-tape" aria-hidden="true"></div>
                <span class="shroud-icon" aria-hidden="true">🕹️</span>
                <p class="shroud-title">{t('fun.arcade.locked.title')}</p>
                <p class="shroud-hint">
                  {t('fun.arcade.locked.hint').replace('{game}', arcadeGames[i - 1].title)}
                </p>
              </div>
            )}
            <div class="floor-slot" data-cabinet={game.id} hidden={i !== 0}>
              <ArcadeCabinet
                id={game.id}
                title={game.title}
                tagline={t(game.taglineKey)}
                genre={t(game.genreKey)}
                players={game.twoPlayer ? t('fun.arcade.twoPlayers') : t('fun.arcade.onePlayer')}
                icon={game.icon}
                color={game.color}
                href={getLocalizedPath(game.path, lang)}
                bestLabel={t('fun.arcade.best')}
              />
            </div>
          </>
        ))}
      </div>
    </div>

    <div class="arcade-decorations">
      <div class="floor-reflection"></div>
    </div>

    <div class="arcade-tip">
      <p>{t('fun.arcade.konamiTip')}</p>
    </div>
  </div>
</Layout>

<script>
  // Fill each cabinet's attract screen with this device's best run at the
  // game, under the initials the player last entered (loading a best migrates
  // it from the retired per-device table, or from the game's pre-table key,
  // automatically). Re-runs after ClientRouter swaps so scores earned in a
  // game show up when navigating back to the arcade.
  import { loadBest, loadInitials, formatScore } from '../../../games/engine/highscores';
  import {
    UNLOCK_CHAIN,
    completedGames,
    visibleCabinets
  } from '../../../games/engine/progress';

  function showBestScores() {
    const readouts = document.querySelectorAll<HTMLElement>('.best-value[data-game-id]');
    // One set of initials serves the whole floor: they are the last ones the
    // player typed, not per-cabinet, so reading them once is enough.
    const initials = loadInitials();
    for (const readout of readouts) {
      const best = readout.dataset.gameId ? loadBest(readout.dataset.gameId) : 0;
      readout.textContent = best > 0 ? `${initials} ${formatScore(best)}` : formatScore(0);
    }
  }

  // The floor is a progressive reveal: unlocked cabinets stand powered, the
  // one after them waits under a shroud, and the rest are not on the floor at
  // all. All the logic is in progress.ts; this only toggles `hidden`.
  function layoutFloor() {
    const { unlocked, next } = visibleCabinets(UNLOCK_CHAIN, completedGames());
    const open = new Set<string>(unlocked);
    for (const slot of document.querySelectorAll<HTMLElement>('.floor-slot[data-cabinet]')) {
      slot.hidden = !open.has(slot.dataset.cabinet ?? '');
    }
    for (const shroud of document.querySelectorAll<HTMLElement>('.locked-cabinet[data-shroud]')) {
      shroud.hidden = shroud.dataset.shroud !== next;
    }
  }

  function refreshFloor() {
    layoutFloor();
    showBestScores();
  }

  refreshFloor();
  document.addEventListener('astro:after-swap', refreshFloor);
</script>

<style>
  /* The room follows the site theme: a bright showroom on the light "paper &
     ink" palette, the neon-dark arcade after dark. Only the room shell reacts —
     the cabinets are dark physical objects in both. */
  .arcade-room {
    --room-bg: linear-gradient(180deg, #eaf0f9 0%, #dde7f7 55%, #cfdcf0 100%);
    --room-grid: rgba(29, 78, 216, 0.08);
    --sign-main: var(--color-text);
    --sign-main-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(37, 99, 235, 0.35),
      0 0 34px rgba(37, 99, 235, 0.2);
    --sign-accent: var(--color-accent-solid);
    --sign-accent-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(0, 183, 255, 0.45),
      0 0 34px rgba(0, 183, 255, 0.25);
    /* Caution tape: the same two colours in both themes — it's a physical
       object in the room, like the cabinets. */
    --tape-stripes: repeating-linear-gradient(-45deg, #f5c518 0 14px, #16161d 14px 28px);

    min-height: calc(100vh - var(--nav-height));
    background: var(--room-bg);
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) var(--space-lg);
  }

  :global(:root[data-theme='dark']) .arcade-room {
    --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
    --room-grid: rgba(59, 130, 246, 0.04);
    --sign-main: #fff;
    --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
    --sign-accent: #0ff;
    --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arcade-room {
      --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
      --room-grid: rgba(59, 130, 246, 0.04);
      --sign-main: #fff;
      --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
      --sign-accent: #0ff;
      --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
    }
  }

  .neon-grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(var(--room-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--room-grid) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% { background-position: 0 0; }
    100% { background-position: 50px 50px; }
  }

  .arcade-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    position: relative;
    z-index: 10;
  }

  .neon-sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .neon-text {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--sign-main);
    text-shadow: var(--sign-main-glow);
    animation: neonFlicker 3s ease-in-out infinite;
  }

  .neon-text.accent {
    color: var(--sign-accent);
    text-shadow: var(--sign-accent-glow);
    animation: neonFlicker 2.5s ease-in-out infinite reverse;
  }

  @keyframes neonFlicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
      opacity: 1;
    }
    20%, 24%, 55% {
      opacity: 0.8;
    }
  }

  .arcade-subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    animation: blink 1.5s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0.5; }
  }

  /* "Pardon our dust": a taped-off notice hanging between the neon sign and
     the half-assembled floor. */
  .dust-sign {
    position: relative;
    z-index: 10;
    max-width: 560px;
    margin: 0 auto var(--space-2xl);
  }

  .tape-line {
    height: 10px;
    border-radius: 2px;
    background: var(--tape-stripes);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .dust-sign p {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }

  .arcade-floor {
    position: relative;
    z-index: 10;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* flex-wrap centres partial rows, so an orphan pair of cabinets doesn't
     hang off the left edge the way a grid row would. */
  .cabinets-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-2xl) var(--space-xl);
    padding: var(--space-xl) 0;
  }

  /* The slot exists only to carry the `hidden` toggle; when visible it
     dissolves so the cabinet remains a direct flex item of the row. */
  .floor-slot:not([hidden]) {
    display: contents;
  }

  /* The one shrouded cabinet: a tarped silhouette waiting to be powered,
     wrapped in caution tape. Dark in both themes, like the live cabinets.
     `display: flex` would override the UA's `[hidden] { display: none }`,
     so the hidden state is restated explicitly. */
  .locked-cabinet[hidden] {
    display: none;
  }

  .locked-cabinet {
    position: relative;
    width: 220px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-md);
    border-radius: 12px 12px 8px 8px;
    border: 2px dashed #3d3d49;
    background:
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.03) 0 18px,
        transparent 18px 36px
      ),
      linear-gradient(180deg, #23232b 0%, #131318 100%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  /* High across the tarp, clear of the title and hint text. */
  .shroud-tape {
    position: absolute;
    top: 16%;
    left: -24px;
    right: -24px;
    height: 16px;
    background: var(--tape-stripes);
    transform: rotate(-7deg);
    opacity: 0.9;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .shroud-icon {
    font-size: 2.5rem;
    filter: grayscale(1) brightness(0.45);
  }

  .shroud-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #6d7486;
  }

  .shroud-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a9b4c6;
  }

  .arcade-decorations {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 150px;
    pointer-events: none;
  }

  .floor-reflection {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(180deg, transparent 0%, rgba(59, 130, 246, 0.06) 100%);
  }

  .arcade-tip {
    text-align: center;
    margin-top: var(--space-3xl);
    position: relative;
    z-index: 10;
  }

  .arcade-tip p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .arcade-room {
      padding: var(--space-xl) var(--space-md);
    }

    .cabinets-row {
      gap: var(--space-xl) var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .neon-text {
      letter-spacing: 0.1em;
    }

    .cabinets-row {
      gap: var(--space-lg) var(--space-md);
    }
  }

  @media (max-width: 600px) {
    .locked-cabinet {
      width: 180px;
      padding: var(--space-lg) var(--space-sm);
    }
  }
</style>
