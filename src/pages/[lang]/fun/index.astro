---
import Layout from '../../../layouts/Layout.astro';
import ArcadeCabinet from '../../../components/ArcadeCabinet.astro';
import { useTranslations, getLocalizedPath, locales } from '../../../i18n/translations';
import type { Locale, TranslationKey } from '../../../i18n/translations';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

type Shelf = 'featured' | 'backCatalogue';

interface ArcadeGame {
  id: string;
  title: string;
  taglineKey: TranslationKey;
  genreKey: TranslationKey;
  shelf: Shelf;
  twoPlayer: boolean;
  icon: string;
  color: string;
  path: string;
  isNew?: boolean;
}

const arcadeGames: ArcadeGame[] = [
  {
    id: 'syndicate',
    shelf: 'featured',
    title: 'SYNDICATE',
    taglineKey: 'fun.syndicate.description',
    genreKey: 'fun.arcade.genre.syndicate',
    twoPlayer: false,
    icon: '🕶️',
    color: '#22d3ee',
    path: '/fun/syndicate'
  },
  {
    id: 'towerdefense',
    shelf: 'featured',
    title: 'LINE HOLD',
    taglineKey: 'fun.towerdefense.description',
    genreKey: 'fun.arcade.genre.towerdefense',
    twoPlayer: false,
    icon: '🏰',
    color: '#f59e0b',
    path: '/fun/towerdefense'
  },
  {
    id: 'lemmings',
    shelf: 'featured',
    title: 'CRITTER RESCUE',
    taglineKey: 'fun.lemmings.description',
    genreKey: 'fun.arcade.genre.lemmings',
    twoPlayer: false,
    icon: '🐛',
    color: '#84cc16',
    path: '/fun/lemmings'
  },
  // Pixel Park is parked: its ride graphics need more work before it ships, so
  // we're stabilising the other cabinets first. Its cabinet is off the floor
  // AND its page is unpublished — renamed to the unrouted
  // src/pages/[lang]/fun/_park.astro, so no /fun/park route is built. The game
  // under src/games/park/ stays in the repo. To bring it back for a future
  // release: rename _park.astro back to park.astro and re-add an entry here.
  {
    id: 'cascade',
    shelf: 'featured',
    title: 'CASCADE',
    taglineKey: 'fun.cascade.description',
    genreKey: 'fun.arcade.genre.cascade',
    twoPlayer: false,
    icon: '🧱',
    color: '#a855f7',
    path: '/fun/cascade',
    isNew: true
  },
  {
    id: 'city',
    shelf: 'backCatalogue',
    title: 'MICROCITY',
    taglineKey: 'fun.city.description',
    genreKey: 'fun.arcade.genre.city',
    twoPlayer: false,
    icon: '🏙️',
    color: '#38bdf8',
    path: '/fun/city'
  },
  {
    id: 'tanks',
    shelf: 'backCatalogue',
    title: 'TANK DUEL',
    taglineKey: 'fun.tanks.description',
    genreKey: 'fun.arcade.genre.tanks',
    twoPlayer: true,
    icon: '🎯',
    color: '#3b82f6',
    path: '/fun/tanks'
  },
  {
    id: 'snake',
    shelf: 'backCatalogue',
    title: 'SNAKE',
    taglineKey: 'fun.snake.description',
    genreKey: 'fun.arcade.genre.snake',
    twoPlayer: false,
    icon: '🐍',
    color: '#14b8a6',
    path: '/fun/snake'
  }
];

// Aisle order on the floor; each shelf renders its own labelled row. The
// Round 6 focus decision (owner-approved list): the five deepest, most
// distinctive cabinets stand on the front shelf, the rest keep playing from
// the back catalogue — nothing retired.
const shelves: { id: Shelf; labelKey: TranslationKey }[] = [
  { id: 'featured', labelKey: 'fun.arcade.shelf.featured' },
  { id: 'backCatalogue', labelKey: 'fun.arcade.shelf.backCatalogue' }
];
---

<Layout title="The Arcade" lang={lang}>
  <div class="arcade-room">
    <div class="neon-grid"></div>

    <div class="arcade-header">
      <h1 class="neon-sign">
        <span class="neon-text">ISMAEL'S</span>
        <span class="neon-text accent">ARCADE</span>
      </h1>
      <p class="arcade-subtitle">{t('fun.arcade.subtitle')}</p>
    </div>

    <div class="arcade-floor">
      {shelves.map(shelf => (
        <section class="arcade-shelf">
          <h2 class="shelf-sign">{t(shelf.labelKey)}</h2>
          <div class="cabinets-row">
            {arcadeGames
              .filter(game => game.shelf === shelf.id)
              .map(game => (
                <ArcadeCabinet
                  id={game.id}
                  title={game.title}
                  tagline={t(game.taglineKey)}
                  genre={t(game.genreKey)}
                  players={game.twoPlayer ? t('fun.arcade.twoPlayers') : t('fun.arcade.onePlayer')}
                  icon={game.icon}
                  color={game.color}
                  href={getLocalizedPath(game.path, lang)}
                  bestLabel={t('fun.arcade.best')}
                  newBadge={game.isNew ? t('fun.arcade.new') : undefined}
                />
              ))}
          </div>
        </section>
      ))}
    </div>

    <div class="arcade-decorations">
      <div class="floor-reflection"></div>
    </div>

    <div class="arcade-tip">
      <p>{t('fun.arcade.konamiTip')}</p>
    </div>
  </div>
</Layout>

<script>
  // Fill each cabinet's attract screen with this device's best run at the
  // game, under the initials the player last entered (loading a best migrates
  // it from the retired per-device table, or from the game's pre-table key,
  // automatically). Re-runs after ClientRouter swaps so scores earned in a
  // game show up when navigating back to the arcade.
  import { loadBest, loadInitials, formatScore } from '../../../games/engine/highscores';

  function showBestScores() {
    const readouts = document.querySelectorAll<HTMLElement>('.best-value[data-game-id]');
    // One set of initials serves the whole floor: they are the last ones the
    // player typed, not per-cabinet, so reading them once is enough.
    const initials = loadInitials();
    for (const readout of readouts) {
      const best = readout.dataset.gameId ? loadBest(readout.dataset.gameId) : 0;
      readout.textContent = best > 0 ? `${initials} ${formatScore(best)}` : formatScore(0);
    }
  }

  showBestScores();
  document.addEventListener('astro:after-swap', showBestScores);
</script>

<style>
  /* The room follows the site theme: a bright showroom on the light "paper &
     ink" palette, the neon-dark arcade after dark. Only the room shell reacts —
     the cabinets are dark physical objects in both. */
  .arcade-room {
    --room-bg: linear-gradient(180deg, #eaf0f9 0%, #dde7f7 55%, #cfdcf0 100%);
    --room-grid: rgba(29, 78, 216, 0.08);
    --sign-main: var(--color-text);
    --sign-main-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(37, 99, 235, 0.35),
      0 0 34px rgba(37, 99, 235, 0.2);
    --sign-accent: var(--color-accent-solid);
    --sign-accent-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(0, 183, 255, 0.45),
      0 0 34px rgba(0, 183, 255, 0.25);

    min-height: calc(100vh - var(--nav-height));
    background: var(--room-bg);
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) var(--space-lg);
  }

  :global(:root[data-theme='dark']) .arcade-room {
    --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
    --room-grid: rgba(59, 130, 246, 0.04);
    --sign-main: #fff;
    --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
    --sign-accent: #0ff;
    --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arcade-room {
      --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
      --room-grid: rgba(59, 130, 246, 0.04);
      --sign-main: #fff;
      --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
      --sign-accent: #0ff;
      --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
    }
  }

  .neon-grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(var(--room-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--room-grid) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% { background-position: 0 0; }
    100% { background-position: 50px 50px; }
  }

  .arcade-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
    position: relative;
    z-index: 10;
  }

  .neon-sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .neon-text {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--sign-main);
    text-shadow: var(--sign-main-glow);
    animation: neonFlicker 3s ease-in-out infinite;
  }

  .neon-text.accent {
    color: var(--sign-accent);
    text-shadow: var(--sign-accent-glow);
    animation: neonFlicker 2.5s ease-in-out infinite reverse;
  }

  @keyframes neonFlicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
      opacity: 1;
    }
    20%, 24%, 55% {
      opacity: 0.8;
    }
  }

  .arcade-subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    animation: blink 1.5s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0.5; }
  }

  .arcade-floor {
    position: relative;
    z-index: 10;
    max-width: 1100px;
    margin: 0 auto;
  }

  .arcade-shelf + .arcade-shelf {
    margin-top: var(--space-2xl);
  }

  /* Aisle signage: same neon family as the main sign, much smaller, with a
     hairline shelf rail running off both sides. */
  .shelf-sign {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--sign-accent);
    text-shadow: var(--sign-accent-glow);
  }

  .shelf-sign::before,
  .shelf-sign::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--sign-accent), transparent);
    opacity: 0.35;
  }

  /* flex-wrap centres partial rows, so an orphan pair of cabinets doesn't
     hang off the left edge the way a grid row would. */
  .cabinets-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-2xl) var(--space-xl);
    padding: var(--space-xl) 0;
  }

  .arcade-decorations {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 150px;
    pointer-events: none;
  }

  .floor-reflection {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(180deg, transparent 0%, rgba(59, 130, 246, 0.06) 100%);
  }

  .arcade-tip {
    text-align: center;
    margin-top: var(--space-3xl);
    position: relative;
    z-index: 10;
  }

  .arcade-tip p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .arcade-room {
      padding: var(--space-xl) var(--space-md);
    }

    .cabinets-row {
      gap: var(--space-xl) var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .neon-text {
      letter-spacing: 0.1em;
    }

    .cabinets-row {
      gap: var(--space-lg) var(--space-md);
    }
  }
</style>
