---
import Layout from '../../../layouts/Layout.astro';
import ArcadeCabinet from '../../../components/ArcadeCabinet.astro';
import { useTranslations, getLocalizedPath, locales } from '../../../i18n/translations';
import type { Locale } from '../../../i18n/translations';
import { UNLOCK_CHAIN } from '../../../games/engine/progress';
import { CABINETS } from '../../../data/arcadeCabinets';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// The floor is under construction: cabinets stand in UNLOCK_CHAIN order — a
// walk through gaming history, oldest homaged classic first — and are
// revealed one at a time (see src/games/engine/progress.ts). The old
// Featured / Back-catalogue shelves are retired with it.
//
// THE NEXT CABINET IS A MYSTERY. Unlock state lives client-side, so only the
// always-on first cabinet and one anonymous shrouded silhouette are rendered
// here; every chain cabinet's display data (name, icon, colour, localized
// copy) is composed in this frontmatter and shipped as the base64 JSON
// island below, which the client script decodes to clone and patch further
// unlocked cabinets. The precise invariant: no PLAINTEXT hidden-cabinet
// identity (marquee name, icon, colour, tagline) in the built HTML or in the
// floor's JS bundle — so client code must never import
// src/data/arcadeCabinets.ts or the translations module. Chain ids (which are
// also route slugs) do remain in the bundle: they are the localStorage key
// names, and the routes are public and sitemapped anyway. The base64 is
// spoiler-guarding, not security: anyone determined can decode it, and that
// is accepted; it only keeps casual view-source and asset-grep clean.
//
// Pixel Park is parked: its ride graphics need more work before it ships, so
// we're stabilising the other cabinets first. Its cabinet is off the floor
// AND its page is unpublished — renamed to the unrouted
// src/pages/[lang]/fun/_park.astro, so no /fun/park route is built. The game
// under src/games/park/ stays in the repo. To bring it back for a future
// release: rename _park.astro back to park.astro and re-add an entry to
// src/data/arcadeCabinets.ts.
//
// Syndicate is parked the same way (2026-08-11): it sat outside the unlock
// chain while the floor is rebuilt, so its cabinet is off the floor AND its
// page is unpublished — renamed to the unrouted
// src/pages/[lang]/fun/_syndicate.astro, so no /fun/syndicate route is built.
// The game under src/games/syndicate/ stays in the repo. To bring it back:
// rename _syndicate.astro back to syndicate.astro, re-add an entry to
// src/data/arcadeCabinets.ts, and slot it into the unlock chain in
// progress.ts.
const firstId = UNLOCK_CHAIN[0];
const first = CABINETS[firstId];

// Everything the client script needs to dress an unlocked cabinet, fully
// localized and pre-formatted here so the client imports neither the cabinet
// catalogue nor the (three-locale) translations dictionary.
const floorCabinets = UNLOCK_CHAIN.map(id => {
  const c = CABINETS[id];
  return {
    id,
    title: c.title,
    icon: c.icon,
    color: c.color,
    href: getLocalizedPath(c.path, lang),
    tagline: t(c.taglineKey),
    genre: t(c.genreKey),
    players: t(c.twoPlayer ? 'fun.arcade.twoPlayers' : 'fun.arcade.onePlayer'),
    // Pre-formatted so the plaque format lives only in ArcadeCabinet.astro
    // and here, not in client code too.
    plaque: `EST. ${c.estYear}`,
    isNew: Boolean(c.isNew),
    // The shroud hint shown while THIS cabinet is the newest unlocked one.
    hint: t('fun.arcade.locked.hint').replace('{game}', c.title)
  };
});
const floorIsland = Buffer.from(
  JSON.stringify({ newLabel: t('fun.arcade.new'), cabinets: floorCabinets }),
  'utf8'
).toString('base64');
---

<Layout title="The Arcade" lang={lang}>
  <div class="arcade-room">
    <div class="neon-grid"></div>

    <div class="arcade-header">
      <h1 class="neon-sign">
        <span class="neon-text">ISMAEL'S</span>
        <span class="neon-text accent">ARCADE</span>
      </h1>
      <p class="arcade-subtitle">{t('fun.arcade.subtitle')}</p>
    </div>

    <div class="dust-sign">
      <div class="tape-line" aria-hidden="true"></div>
      <p>{t('fun.arcade.wip.sign')}</p>
      <div class="tape-line" aria-hidden="true"></div>
    </div>

    <noscript>
      <p class="arcade-noscript">{t('fun.arcade.noscript')}</p>
    </noscript>

    <div class="arcade-floor">
      <div class="cabinets-row" data-floor>
        <ArcadeCabinet
          id={firstId}
          title={first.title}
          tagline={t(first.taglineKey)}
          genre={t(first.genreKey)}
          players={first.twoPlayer ? t('fun.arcade.twoPlayers') : t('fun.arcade.onePlayer')}
          icon={first.icon}
          color={first.color}
          href={getLocalizedPath(first.path, lang)}
          bestLabel={t('fun.arcade.best')}
          newBadge={first.isNew ? t('fun.arcade.new') : undefined}
          estYear={first.estYear}
        />
        {/* The one mystery cabinet: a tarped silhouette that identifies
            nothing. Its hint names only the game before it in the chain —
            server-rendered for the fresh-floor default (and no-JS), retargeted
            client-side once real progress is known. */}
        <div class="locked-cabinet" data-shroud>
          <div class="shroud-tape" aria-hidden="true"></div>
          <span class="shroud-icon" aria-hidden="true">?</span>
          <p class="shroud-title">{t('fun.arcade.locked.title')}</p>
          <p class="shroud-hint">
            {t('fun.arcade.locked.hint').replace('{game}', first.title)}
          </p>
        </div>
      </div>
    </div>

    {/* The floor's data island: every chain cabinet's display data, composed
        and localized server-side, base64 of JSON so casual view-source and
        asset-grep stay free of hidden cabinet names. Not a security boundary
        (see the frontmatter note) — a spoiler guard. */}
    <script type="application/json" data-floor-data set:html={floorIsland} is:inline />

    <div class="arcade-decorations">
      <div class="floor-reflection"></div>
    </div>

    <div class="arcade-tip">
      <p>{t('fun.arcade.konamiTip')}</p>
    </div>
  </div>
</Layout>

<script>
  // The floor is a progressive reveal whose state lives in this device's
  // localStorage, so it is laid out here rather than at build time: the static
  // HTML carries only the always-on first cabinet and the anonymous shroud,
  // and every further unlocked cabinet is cloned from the first one — the
  // clone keeps Astro's scoped-style attributes — then patched from the
  // base64 data island the page frontmatter composed.
  //
  // This script must NOT import src/data/arcadeCabinets.ts or the
  // translations module: the first would ship every hidden cabinet's name,
  // icon and colour in the bundle in plaintext (defeating the mystery), the
  // second would bundle the whole three-locale dictionary to render five
  // taglines (against the repo's server-side-labels rule). All display data
  // arrives already localized and pre-formatted through the island. All the
  // unlock logic is in progress.ts (tested); this only builds DOM.
  import { loadBest, loadInitials, formatScore } from '../../../games/engine/highscores';
  import {
    UNLOCK_CHAIN,
    completedGames,
    visibleCabinets
  } from '../../../games/engine/progress';

  interface CabinetView {
    id: string;
    title: string;
    icon: string;
    color: string;
    href: string;
    tagline: string;
    genre: string;
    players: string;
    /** Ready-formatted "EST. 1974": the plaque format lives server-side. */
    plaque: string;
    isNew: boolean;
    /** Shroud copy naming this cabinet as the one that powers the next. */
    hint: string;
  }

  interface FloorData {
    newLabel: string;
    cabinets: CabinetView[];
  }

  function readIsland(): FloorData | null {
    const el = document.querySelector('[data-floor-data]');
    if (!el?.textContent) return null;
    try {
      // atob yields bytes, and the payload is UTF-8 (emoji icons, accented
      // Spanish and Catalan copy), so it needs decoding rather than reading
      // as latin1.
      const bytes = Uint8Array.from(atob(el.textContent.trim()), c => c.charCodeAt(0));
      return JSON.parse(new TextDecoder().decode(bytes)) as FloorData;
    } catch {
      return null;
    }
  }

  function setText(root: HTMLElement, selector: string, text: string) {
    const el = root.querySelector<HTMLElement>(selector);
    if (el) el.textContent = text;
  }

  /** Astro's scoped-style marker, so elements we create are styled too. */
  function scopeAttr(el: HTMLElement): string | null {
    return el.getAttributeNames().find(n => n.startsWith('data-astro-cid-')) ?? null;
  }

  /** The localized "New" ribbon, added or removed to match the cabinet. */
  function applyRibbon(clone: HTMLElement, isNew: boolean, label: string) {
    const existing = clone.querySelector<HTMLElement>('.new-ribbon');
    if (!isNew) {
      existing?.remove();
      return;
    }
    const ribbon = existing ?? document.createElement('span');
    if (!existing) {
      ribbon.className = 'new-ribbon';
      const scope = scopeAttr(clone);
      if (scope) ribbon.setAttribute(scope, '');
      clone.prepend(ribbon);
    }
    ribbon.textContent = label;
  }

  function buildFloor() {
    const row = document.querySelector<HTMLElement>('[data-floor]');
    const base = row?.querySelector<HTMLElement>('.arcade-cabinet');
    const shroud = row?.querySelector<HTMLElement>('[data-shroud]');
    const island = readIsland();
    if (!row || !base || !shroud || !island) return;

    // Rebuilds start from the server floor: only clones are ever added, so
    // only clones need clearing.
    for (const old of row.querySelectorAll('[data-floor-clone]')) old.remove();

    const byId = new Map(island.cabinets.map(c => [c.id, c]));
    const { unlocked, next } = visibleCabinets(UNLOCK_CHAIN, completedGames());

    for (const id of unlocked.slice(1)) {
      const meta = byId.get(id);
      if (!meta) continue;
      const clone = base.cloneNode(true) as HTMLAnchorElement;
      clone.setAttribute('data-floor-clone', '');
      clone.dataset.game = id;
      clone.href = meta.href;
      clone.style.setProperty('--cabinet-color', meta.color);
      clone.style.setProperty('--cabinet-glow', `${meta.color}40`);
      setText(clone, '.marquee-text', meta.title);
      setText(clone, '.screen-icon', meta.icon);
      setText(clone, '.game-desc', meta.tagline);
      setText(clone, '.chip-genre', meta.genre);
      setText(clone, '.chip-players', meta.players);
      setText(clone, '.est-plaque', meta.plaque);
      applyRibbon(clone, meta.isNew, island.newLabel);
      const best = clone.querySelector<HTMLElement>('.best-value');
      if (best) best.dataset.gameId = id;
      shroud.before(clone);
    }

    // The newest unlocked cabinet is, by construction, the shroud's immediate
    // predecessor in the chain (proven in progress.test.ts), so its hint is
    // the one the shroud wears.
    const newest = byId.get(unlocked[unlocked.length - 1]);
    shroud.hidden = next === null;
    if (newest) setText(shroud, '.shroud-hint', newest.hint);
  }

  // Fill each cabinet's attract screen with this device's best run at the
  // game, under the initials the player last entered (loading a best migrates
  // it from the retired per-device table, or from the game's pre-table key,
  // automatically).
  function showBestScores() {
    const readouts = document.querySelectorAll<HTMLElement>('.best-value[data-game-id]');
    // One set of initials serves the whole floor: they are the last ones the
    // player typed, not per-cabinet, so reading them once is enough.
    const initials = loadInitials();
    for (const readout of readouts) {
      const best = readout.dataset.gameId ? loadBest(readout.dataset.gameId) : 0;
      readout.textContent = best > 0 ? `${initials} ${formatScore(best)}` : formatScore(0);
    }
  }

  // Re-runs after ClientRouter swaps so progress made in a game shows up when
  // navigating back to the arcade.
  function refreshFloor() {
    buildFloor();
    showBestScores();
  }

  refreshFloor();
  document.addEventListener('astro:after-swap', refreshFloor);
</script>

<style>
  /* The room follows the site theme: a bright showroom on the light "paper &
     ink" palette, the neon-dark arcade after dark. Only the room shell reacts —
     the cabinets are dark physical objects in both. */
  .arcade-room {
    --room-bg: linear-gradient(180deg, #eaf0f9 0%, #dde7f7 55%, #cfdcf0 100%);
    --room-grid: rgba(29, 78, 216, 0.08);
    --sign-main: var(--color-text);
    --sign-main-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(37, 99, 235, 0.35),
      0 0 34px rgba(37, 99, 235, 0.2);
    --sign-accent: var(--color-accent-solid);
    --sign-accent-glow:
      0 0 1px rgba(29, 78, 216, 0.5),
      0 0 14px rgba(0, 183, 255, 0.45),
      0 0 34px rgba(0, 183, 255, 0.25);
    /* Caution tape: the same two colours in both themes — it's a physical
       object in the room, like the cabinets. */
    --tape-stripes: repeating-linear-gradient(-45deg, #f5c518 0 14px, #16161d 14px 28px);

    min-height: calc(100vh - var(--nav-height));
    background: var(--room-bg);
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) var(--space-lg);
  }

  :global(:root[data-theme='dark']) .arcade-room {
    --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
    --room-grid: rgba(59, 130, 246, 0.04);
    --sign-main: #fff;
    --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
    --sign-accent: #0ff;
    --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .arcade-room {
      --room-bg: linear-gradient(180deg, #0a0a12 0%, #1a1a2e 50%, #16213e 100%);
      --room-grid: rgba(59, 130, 246, 0.04);
      --sign-main: #fff;
      --sign-main-glow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #2563eb, 0 0 40px #2563eb, 0 0 80px #2563eb;
      --sign-accent: #0ff;
      --sign-accent-glow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #00b7ff, 0 0 80px #00b7ff;
    }
  }

  .neon-grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(var(--room-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--room-grid) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% { background-position: 0 0; }
    100% { background-position: 50px 50px; }
  }

  .arcade-header {
    text-align: center;
    margin-bottom: var(--space-xl);
    position: relative;
    z-index: 10;
  }

  .neon-sign {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .neon-text {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--sign-main);
    text-shadow: var(--sign-main-glow);
    animation: neonFlicker 3s ease-in-out infinite;
  }

  .neon-text.accent {
    color: var(--sign-accent);
    text-shadow: var(--sign-accent-glow);
    animation: neonFlicker 2.5s ease-in-out infinite reverse;
  }

  @keyframes neonFlicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
      opacity: 1;
    }
    20%, 24%, 55% {
      opacity: 0.8;
    }
  }

  .arcade-subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    animation: blink 1.5s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0.5; }
  }

  /* "Pardon our dust": a taped-off notice hanging between the neon sign and
     the half-assembled floor. */
  .dust-sign {
    position: relative;
    z-index: 10;
    max-width: 560px;
    margin: 0 auto var(--space-2xl);
  }

  .tape-line {
    height: 10px;
    border-radius: 2px;
    background: var(--tape-stripes);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .dust-sign p {
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
  }

  /* Without JavaScript the floor is only the first cabinet and the shroud —
     the unlocked ones are cloned client-side — so say so. The game pages
     themselves stay reachable (and sitemapped). */
  .arcade-noscript {
    position: relative;
    z-index: 10;
    max-width: 560px;
    margin: 0 auto var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .arcade-floor {
    position: relative;
    z-index: 10;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* flex-wrap centres partial rows, so an orphan pair of cabinets doesn't
     hang off the left edge the way a grid row would. */
  .cabinets-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-2xl) var(--space-xl);
    padding: var(--space-xl) 0;
  }

  /* The one shrouded cabinet: a tarped silhouette waiting to be powered,
     wrapped in caution tape. Dark in both themes, like the live cabinets.
     `display: flex` would override the UA's `[hidden] { display: none }`,
     so the hidden state is restated explicitly. */
  .locked-cabinet[hidden] {
    display: none;
  }

  .locked-cabinet {
    position: relative;
    width: 220px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-md);
    border-radius: 12px 12px 8px 8px;
    border: 2px dashed #3d3d49;
    background:
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.03) 0 18px,
        transparent 18px 36px
      ),
      linear-gradient(180deg, #23232b 0%, #131318 100%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  /* High across the tarp, clear of the question mark and hint text. */
  .shroud-tape {
    position: absolute;
    top: 16%;
    left: -24px;
    right: -24px;
    height: 16px;
    background: var(--tape-stripes);
    transform: rotate(-7deg);
    opacity: 0.9;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .shroud-icon {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
    color: #4a5162;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .shroud-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #6d7486;
  }

  .shroud-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a9b4c6;
  }

  .arcade-decorations {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 150px;
    pointer-events: none;
  }

  .floor-reflection {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(180deg, transparent 0%, rgba(59, 130, 246, 0.06) 100%);
  }

  .arcade-tip {
    text-align: center;
    margin-top: var(--space-3xl);
    position: relative;
    z-index: 10;
  }

  .arcade-tip p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .arcade-room {
      padding: var(--space-xl) var(--space-md);
    }

    .cabinets-row {
      gap: var(--space-xl) var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .neon-text {
      letter-spacing: 0.1em;
    }

    .cabinets-row {
      gap: var(--space-lg) var(--space-md);
    }
  }

  @media (max-width: 600px) {
    .locked-cabinet {
      width: 180px;
      padding: var(--space-lg) var(--space-sm);
    }
  }
</style>
