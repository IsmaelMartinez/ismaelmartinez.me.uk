---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/arcade.css';
import HighScoreTable from '../../../components/HighScoreTable.astro';
import SoundToggles from '../../../components/SoundToggles.astro';
import ToastArea from '../../../components/ToastArea.astro';
import { useTranslations, getLocalizedPath, type TranslationKey } from '../../../i18n/translations';
import { arcadePaths } from '../../../data/release';
import { FIGHTERS, SELECTABLE, BOSSES, type CharId } from '../../../games/fighter/roster';
import type { Motion } from '../../../games/fighter/motion';
import type { Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return arcadePaths('fighter');
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const k = (key: string) => t(`fun.fighter.${key}` as TranslationKey);

/**
 * Every word the framebuffer draws, composed here in the page's locale and
 * shipped as one JSON island, so the cabinet's script never imports the
 * translations module (the arcade's server-side-labels rule).
 */
const ALL: CharId[] = [...SELECTABLE, ...BOSSES];
const labels = {
  select: k('label.select'),
  pressStart: k('label.pressStart'),
  continueQ: k('label.continueQ'),
  bonusStage: k('label.bonusStage'),
  timeBonus: k('label.timeBonus'),
  vitalBonus: k('label.vitalBonus'),
  perfectBonus: k('label.perfectBonus'),
  clearBonus: k('label.clearBonus'),
  congratulations: k('label.congratulations'),
  ending: k('label.ending'),
  versusMode: k('label.versusMode'),
  quotes: Object.fromEntries(ALL.map(id => [id, k(`quote.${id}`)])),
  endings: Object.fromEntries(ALL.map(id => [id, k(`ending.${id}`)]))
};

/**
 * The instruction card's notation: arrows for a fighter facing right, P and
 * K for any punch and any kick, the way the cabinet's move card printed them.
 */
function notation(motion: Motion, button: 'P' | 'K'): string {
  switch (motion) {
    case 'qcf':
      return `↓ ↘ → + ${button}`;
    case 'qcb':
      return `↓ ↙ ← + ${button}`;
    case 'dp':
      return `→ ↓ ↘ + ${button}`;
    case 'hcb':
      return `→ ↘ ↓ ↙ ← + ${button}`;
    case 'chargeBF':
      return `← (${k('moves.hold')}) → + ${button}`;
    case 'chargeDU':
      return `↓ (${k('moves.hold')}) ↑ + ${button}`;
    case 'mash':
      return `${button} ${button} ${button} ${button} (${k('moves.mash')})`;
    case 'ppp':
      return 'LP + MP + HP';
  }
}

const MOVES = SELECTABLE.map(id => ({
  id,
  name: FIGHTERS[id].name,
  moves: FIGHTERS[id].specials.map(s => ({ name: s.name, how: notation(s.motion, s.button) }))
}));

type Row = { label: string; keys?: string[]; alt?: string[]; text?: string };
const CONTROLS: { title: string; rows: Row[] }[] = [
  {
    title: k('controls.p1'),
    rows: [
      { label: k('controls.move'), keys: ['W', 'A', 'S', 'D'], text: k('controls.p1Arrows') },
      { label: k('controls.punch'), keys: ['U', 'I', 'O'], text: k('controls.lmh') },
      { label: k('controls.kick'), keys: ['J', 'K', 'L'], text: k('controls.lmh') },
      { label: k('controls.pause'), keys: ['P'], alt: ['Esc'] }
    ]
  },
  {
    title: k('controls.p2'),
    rows: [
      { label: k('controls.move'), keys: ['↑', '←', '↓', '→'] },
      { label: k('controls.punch'), keys: ['7', '8', '9'], alt: ['Ins', 'Home', 'PgUp'] },
      { label: k('controls.kick'), keys: ['4', '5', '6'], alt: ['Del', 'End', 'PgDn'] }
    ]
  },
  {
    title: k('controls.gamepad'),
    rows: [
      { label: k('controls.move'), text: k('controls.padMove') },
      { label: k('controls.punch'), text: k('controls.padPunch') },
      { label: k('controls.kick'), text: k('controls.padKick') },
      { label: k('controls.pause'), text: k('controls.padPause') }
    ]
  },
  {
    title: k('controls.touch'),
    rows: [
      { label: k('controls.move'), text: k('controls.touchMove') },
      { label: k('controls.punch'), text: k('controls.touchButtons') },
      { label: k('controls.pause'), text: k('controls.touchPause') }
    ]
  }
];
---

<Layout title="Street Champion" lang={lang}>
  <section class="fighter-section">
    <div class="container">
      <a href={getLocalizedPath('/fun', lang)} class="back-link">← {t('fun.backToFun')}</a>

      <div
        class="game-container"
        id="fighter-root"
        data-t-paused={k('paused')}
        data-t-new-record={k('newRecord')}
        data-t-game-over={k('gameOver')}
        data-t-game-over-desc={k('gameOverDesc')}
        data-t-champion={k('champion')}
        data-t-champion-desc={k('championDesc')}
        data-t-continue-against={k('continueAgainst')}
      >
        <script type="application/json" id="fighter-labels" set:html={JSON.stringify(labels)} />
        <div class="game-header">
          <h1><span class="fighter-emoji">🥊</span> {k('title')}</h1>
          <SoundToggles lang={lang} />
          <button type="button" id="pause-btn" class="btn sound-btn" aria-label={k('pause')}>⏸</button>
        </div>

        <div class="game-area">
          <canvas id="game-canvas"></canvas>
          <ToastArea />

          <div id="start-overlay" class="game-overlay">
            <div class="overlay-content">
              <span class="play-icon">🥊</span>
              <h2>{k('title')}</h2>
              <p class="tagline">{k('tagline')}</p>
              <p class="instructions">{k('instructions')}</p>
              <div class="start-buttons">
                <button id="start-btn" class="btn btn-primary btn-large">{k('start')}</button>
                <button id="versus-btn" class="btn btn-large">{k('versus')}</button>
              </div>
            </div>
          </div>

          <div id="over-overlay" class="game-overlay" style="display: none;">
            <div class="overlay-content">
              <span class="play-icon">🥊</span>
              <h2 id="over-title">{k('gameOver')}</h2>
              <p id="over-desc">{k('gameOverDesc')}</p>
              <p class="final-stats">
                {k('finalScore')}: <strong id="final-score">0</strong>
              </p>
              <HighScoreTable gameId="fighter" lang={lang} accent="#f8d818" />
              <div class="start-buttons">
                <button id="continue-btn" class="btn btn-primary btn-large">{k('continueAgainst')}</button>
                <button id="again-btn" class="btn btn-large">{k('playAgain')}</button>
              </div>
            </div>
          </div>
        </div>

        <div id="touch-pad" class="touch-pad" aria-hidden="true">
          <div class="touch-stick" data-stick><span class="touch-knob" data-knob></span></div>
          <div class="touch-buttons">
            <button type="button" data-button="lp">LP</button>
            <button type="button" data-button="mp">MP</button>
            <button type="button" data-button="hp">HP</button>
            <button type="button" data-button="lk">LK</button>
            <button type="button" data-button="mk">MK</button>
            <button type="button" data-button="hk">HK</button>
          </div>
        </div>

        <p class="hint">{k('hint')}</p>

        <section class="controls-guide" aria-labelledby="controls-title">
          <h2 id="controls-title">{k('controls.title')}</h2>
          <p class="controls-how">{k('controls.how')}</p>
          <div class="controls-grid">
            {CONTROLS.map(card => (
              <div class="controls-card">
                <h3>{card.title}</h3>
                <dl>
                  {card.rows.map(row => (
                    <>
                      <dt>{row.label}</dt>
                      <dd>
                        {row.keys && <span class="keys">{row.keys.map(key => <kbd>{key}</kbd>)}</span>}
                        {row.alt && (
                          <>
                            <span class="keys-or">{k('controls.or')}</span>
                            <span class="keys">{row.alt.map(key => <kbd>{key}</kbd>)}</span>
                          </>
                        )}
                        {row.text && <span class="keys-text">{row.text}</span>}
                      </dd>
                    </>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </section>

        <section class="controls-guide" aria-labelledby="moves-title">
          <h2 id="moves-title">{k('moves.title')}</h2>
          <p class="controls-how">{k('moves.how')} {k('moves.close')}: → / ← + MP / HP.</p>
          <div class="controls-grid moves-grid">
            {MOVES.map(f => (
              <div class="controls-card">
                <h3>{f.name}</h3>
                <dl>
                  {f.moves.map(m => (
                    <>
                      <dt>{m.name}</dt>
                      <dd class="motion">{m.how}</dd>
                    </>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script>
  // ClientRouter swaps don't re-execute this module, so returning to the
  // page would otherwise leave a dead, unwired cabinet. Re-init after every
  // swap; initFighterGame no-ops on pages without a fresh root.
  import { initFighterGame } from '../../../games/fighter';
  initFighterGame();
  document.addEventListener('astro:after-swap', initFighterGame);
</script>

<style>
  .fighter-section {
    min-height: calc(100vh - var(--nav-height) - 200px);
    padding: var(--space-2xl) 0;
  }

  /* Wide enough for the 384 x 224 framebuffer at 2x on a 1x screen. */
  .game-container {
    max-width: 820px;
  }

  .fighter-emoji {
    display: inline-block;
    animation: jab 1.4s steps(2, end) infinite;
  }

  @keyframes jab {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(3px); }
  }

  .game-area {
    background: #000;
    display: flex;
    justify-content: center;
  }

  /* The size is set by game.ts in device pixels (a whole multiple of the
     framebuffer); the stylesheet must never give it a width. */
  #game-canvas {
    display: block;
    image-rendering: pixelated;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .overlay-content {
    max-width: 540px;
  }

  .overlay-content h2 {
    margin: 0 0 var(--space-xs);
    color: #f8d818;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    text-shadow: 2px 2px 0 #c82020, 0 0 10px rgba(248, 120, 24, 0.6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overlay-content p {
    margin: 0 0 var(--space-md);
    color: var(--color-text);
  }

  .overlay-content .tagline {
    color: #f87818;
    font-weight: 600;
  }

  .overlay-content .instructions {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .start-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  .final-stats strong {
    color: #f8d818;
  }

  /* The on-screen pad, for touch screens only. */
  .touch-pad {
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  @media (pointer: coarse) {
    .touch-pad {
      display: flex;
    }
  }

  .touch-stick {
    position: relative;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    background: radial-gradient(circle, #2a2a34 0%, #16161c 70%);
    border: 3px solid #4a4a58;
    touch-action: none;
  }

  .touch-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff6a6a, #c01818 70%);
    box-shadow: 0 3px 0 #600808;
    transition: transform 40ms linear;
  }

  .touch-buttons {
    display: grid;
    grid-template-columns: repeat(3, 56px);
    gap: 10px;
  }

  .touch-buttons button {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    font: 700 0.8rem ui-monospace, monospace;
    color: #fff;
    touch-action: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.5);
  }

  .touch-buttons button:nth-child(-n + 3) {
    background: radial-gradient(circle at 35% 30%, #6ab0ff, #1858c8 70%);
  }

  .touch-buttons button:nth-child(n + 4) {
    background: radial-gradient(circle at 35% 30%, #ffe070, #d89808 70%);
    color: #301800;
  }

  .touch-buttons button.down {
    transform: translateY(3px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }

  .controls-guide {
    margin-top: var(--space-xl);
  }

  .controls-guide h2 {
    margin: 0 0 var(--space-xs);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f8d818;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
  }

  .controls-how {
    margin: 0 0 var(--space-md);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .controls-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .controls-card {
    padding: var(--space-sm) var(--space-md) var(--space-md);
    background: #120a0a;
    border: 2px solid #8a2020;
    border-top-color: #d84040;
    border-left-color: #d84040;
    color: #ece4dc;
  }

  .controls-card h3 {
    margin: 0 0 var(--space-sm);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f87818;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
  }

  .controls-card dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    align-items: baseline;
  }

  .controls-card dt {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b8a8a0;
  }

  .controls-card dd {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .controls-card dd.motion {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    color: #f8d818;
  }

  .keys {
    display: inline-flex;
    gap: 0.25rem;
    vertical-align: middle;
  }

  .keys-or {
    margin: 0 0.4rem;
    color: #b8a8a0;
    font-size: 0.75rem;
  }

  .keys-text {
    display: block;
    color: #ece4dc;
  }

  .keys + .keys-text {
    margin-top: 0.25rem;
    color: #b8a8a0;
    font-size: 0.78rem;
  }

  kbd {
    display: inline-block;
    min-width: 1.6rem;
    padding: 0.1rem 0.4rem;
    text-align: center;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: #f8d818;
    background: #241414;
    border: 1px solid #8a2020;
    border-bottom-width: 3px;
    border-radius: 4px;
  }

  @media (max-width: 600px) {
    .controls-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
