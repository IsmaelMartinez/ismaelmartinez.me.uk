---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { useTranslations, locales, getLocalizedPath } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import { getFeaturedProjects } from '../../data/projects';
import { getPublishedArticles } from '../../utils/articles';
import { personJsonLd, toJsonLd } from '../../data/person';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const featuredProjects = getFeaturedProjects().slice(0, 3);

const latestArticles = (await getPublishedArticles(lang)).slice(0, 3);
---

<Layout title={t('nav.home')} description={t('hero.description')} lang={lang}>
  <script slot="head" type="application/ld+json" set:html={toJsonLd(personJsonLd)} />
  <Hero lang={lang} />

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t('section.projects')}</h2>
      <p class="section-description">{t('section.projects.description')}</p>
      <div class="grid grid-3">
        {featuredProjects.map(project => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
      <div class="section-footer">
        <a href={getLocalizedPath('/projects', lang)} class="btn btn-outline">
          {t('common.viewAll')} →
        </a>
      </div>
    </div>
  </section>

  {latestArticles.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">{t('section.writing')}</h2>
        <p class="section-description">{t('section.writing.description')}</p>
        <div class="grid grid-3">
          {latestArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              publishedDate={article.data.publishedDate}
              slug={article.id.replace(`${lang}/`, '')}
              heroImage={article.data.heroImage}
              tags={article.data.tags}
              lang={lang}
              originalPlatform={article.data.originalPlatform}
            />
          ))}
        </div>
        <div class="section-footer">
          <a href={getLocalizedPath('/writing', lang)} class="btn btn-outline">
            {t('common.viewAll')} →
          </a>
        </div>
      </div>
    </section>
  )}

  <ContactCTA lang={lang} />
</Layout>

<style>
  .section-footer {
    margin-top: var(--space-xl);
    text-align: center;
  }
</style>
