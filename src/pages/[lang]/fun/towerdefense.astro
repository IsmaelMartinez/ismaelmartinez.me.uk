---
import Layout from '../../../layouts/Layout.astro';
import HighScoreTable from '../../../components/HighScoreTable.astro';
import SoundToggles from '../../../components/SoundToggles.astro';
import ToastArea from '../../../components/ToastArea.astro';
import { useTranslations, getLocalizedPath, locales } from '../../../i18n/translations';
import type { Locale } from '../../../i18n/translations';
import {
  TOWERS,
  TOWER_KINDS,
  createTower,
  towerDps,
  towerRange
} from '../../../games/towerdefense/towers';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// The tool bar is rendered from the tower table rather than typed into the
// markup (#263). Cost used to be the only figure on a button and it ranks the
// three the wrong way round: frost is cheaper than blast and a ninth of a
// bolt's damage per pound against a warlord, so a player buying by price
// builds a line that never recovers. These are level-1 figures, which is what
// the button is offering to sell. Deriving them here is also what stops the UI
// drifting from the table: the old markup had `70`, `110` and `90` hand-typed.
const tools = TOWER_KINDS.map(kind => {
  const fresh = createTower(kind, 0);
  return {
    kind,
    name: t(`fun.towerdefense.tower${kind[0].toUpperCase()}${kind.slice(1)}` as never),
    cost: TOWERS[kind].cost,
    dps: Math.round(towerDps(fresh)),
    range: towerRange(fresh),
    splash: TOWERS[kind].splash,
    slow: TOWERS[kind].slow
  };
});
---

<Layout title="Line Hold" lang={lang}>
  <section class="towerdefense-section">
    <div class="container">
      <a href={getLocalizedPath('/fun', lang)} class="back-link">← {t('fun.backToFun')}</a>

      <div
        class="game-container"
        id="towerdefense-root"
        data-t-wave-in={t('fun.towerdefense.waveIn')}
        data-t-wave-now={t('fun.towerdefense.waveNow')}
        data-t-wave-cleared={t('fun.towerdefense.waveCleared')}
        data-t-wave-leaked={t('fun.towerdefense.waveLeaked')}
        data-t-interest={t('fun.towerdefense.interest')}
        data-t-new-record={t('fun.towerdefense.newRecord')}
        data-t-breach={t('fun.towerdefense.breach')}
        data-t-victory={t('fun.towerdefense.victory')}
        data-t-victory-desc={t('fun.towerdefense.victoryDesc')}
        data-t-game-over={t('fun.towerdefense.gameOver')}
        data-t-game-over-desc={t('fun.towerdefense.gameOverDesc')}
        data-t-stood-down={t('fun.towerdefense.stoodDown')}
        data-t-stood-down-desc={t('fun.towerdefense.stoodDownDesc')}
        data-t-max-level={t('fun.towerdefense.maxLevel')}
        data-t-level={t('fun.towerdefense.level')}
        data-t-tower-bolt={t('fun.towerdefense.towerBolt')}
        data-t-tower-blast={t('fun.towerdefense.towerBlast')}
        data-t-tower-frost={t('fun.towerdefense.towerFrost')}
      >
        <div class="game-header">
          <h1><span class="td-emoji">🏰</span> {t('fun.towerdefense.title')}</h1>
          <SoundToggles lang={lang} />
          <div class="scores">
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.funds')}</span>
              <span id="money" class="score-value money">0</span>
            </div>
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.lives')}</span>
              <span id="lives" class="score-value lives">0</span>
            </div>
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.wave')}</span>
              <span id="wave-num" class="score-value">—</span>
            </div>
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.score')}</span>
              <span id="score" class="score-value">0</span>
            </div>
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.record')}</span>
              <span id="record" class="score-value">0</span>
            </div>
            <div class="score-item">
              <span class="score-label">{t('fun.towerdefense.seed')}</span>
              <span id="seed" class="score-value seed">—</span>
            </div>
          </div>
        </div>

        <div class="game-area">
          <div class="canvas-scroll" id="canvas-scroll">
            <canvas id="game-canvas"></canvas>
          </div>
          <ToastArea />

          <div id="start-overlay" class="game-overlay">
            <div class="overlay-content">
              <span class="play-icon">🏰</span>
              <h2>{t('fun.towerdefense.title')}</h2>
              <p class="instructions">{t('fun.towerdefense.instructions')}</p>
              <button id="start-btn" class="btn btn-primary btn-large">
                {t('fun.towerdefense.start')}
              </button>
            </div>
          </div>

          <div id="over-overlay" class="game-overlay" style="display: none;">
            <div class="overlay-content">
              <span id="over-icon" class="play-icon">💥</span>
              <!-- Focusable so the end of a run can be handed somewhere: the
                   overlay arrives over a dismissed prompt (stand down) or out
                   of the blue (a breach), and a heading that names which one it
                   was is what a screen reader should read next. -->
              <h2 id="over-title" tabindex="-1"></h2>
              <p id="over-desc"></p>
              <p class="final-stats">
                {t('fun.towerdefense.finalScore')}: <strong id="final-score">0</strong>
              </p>
              <HighScoreTable gameId="towerdefense" lang={lang} accent="#f59e0b" />
              <button id="again-btn" class="btn btn-primary btn-large">
                {t('fun.towerdefense.playAgain')}
              </button>
            </div>
          </div>

          <!-- The guard on the one irreversible control in the game. Standing
               the garrison down cannot be undone, so it costs a second,
               deliberate click on a different button in a different place: a
               stray coordinate that lands on it can no longer end a defence
               that took many minutes to build. Cancel is the primary action and
               takes focus, so a keyboard or screen reader user lands on the
               safe answer first.

               Deliberately no `aria-modal`: this overlay is painted over the
               battlefield alone, so the tower tools and the site chrome stay
               pointer-reachable while it is open. Only the keyboard is trapped.
               Claiming modality would tell assistive technology the rest of the
               page is inert when it demonstrably is not. -->
          <div
            id="stand-down-overlay"
            class="game-overlay"
            style="display: none;"
            tabindex="-1"
            role="alertdialog"
            aria-labelledby="stand-down-title"
            aria-describedby="stand-down-desc"
          >
            <div class="overlay-content">
              <span class="play-icon" aria-hidden="true">🏳️</span>
              <h2 id="stand-down-title" class="stood-down">{t('fun.towerdefense.standDownConfirmTitle')}</h2>
              <p id="stand-down-desc">{t('fun.towerdefense.standDownConfirmDesc')}</p>
              <div class="confirm-actions">
                <button type="button" id="stand-down-cancel" class="btn btn-primary btn-large">{t('fun.towerdefense.standDownConfirmNo')}</button>
                <button type="button" id="stand-down-confirm" class="btn btn-outline btn-large">{t('fun.towerdefense.standDownConfirmYes')}</button>
              </div>
            </div>
          </div>
        </div>

        <div class="controls">
          <div class="tool-bar">
            {
              tools.map((tool, i) => (
                <button
                  class:list={['tower-tool', { active: i === 0 }]}
                  data-kind={tool.kind}
                  disabled
                >
                  <span class:list={['tool-swatch', `swatch-${tool.kind}`]} />
                  <span class="tool-name">{tool.name}</span>
                  <span class="tool-cost">{tool.cost}</span>
                  <span class="tool-stats">
                    <span class="tool-stat" title={t('fun.towerdefense.statDps')}>
                      ⚔ {tool.dps}
                    </span>
                    <span class="tool-stat" title={t('fun.towerdefense.statRange')}>
                      ◎ {tool.range}
                    </span>
                    {tool.splash > 0 && (
                      <span class="tool-stat" title={t('fun.towerdefense.statSplash')}>
                        💥 {tool.splash}
                      </span>
                    )}
                    {tool.slow > 0 && (
                      <span class="tool-stat" title={t('fun.towerdefense.statSlow')}>
                        ❄ {tool.slow}
                      </span>
                    )}
                  </span>
                </button>
              ))
            }
          </div>
          <div class="action-bar">
            <span id="tower-info" class="tower-info" hidden></span>
            <button
              id="upgrade-btn"
              class="btn upgrade-btn"
              title={t('fun.towerdefense.upgrade')}
              hidden
            ></button>
            <button id="wave-btn" class="btn wave-btn" disabled>▶</button>
          </div>
          <!-- Deliberately its own group, not a third button in the action bar:
               the hand reaching for the wave launcher should not be able to
               land on the control that ends the run. -->
          <div class="run-controls">
            <button
              type="button"
              id="stand-down-btn"
              class="stand-down-btn"
              title={t('fun.towerdefense.standDownHint')}
              disabled
            ><span aria-hidden="true">🏳️</span> {t('fun.towerdefense.standDown')}</button>
          </div>
        </div>
        <p class="hint">{t('fun.towerdefense.hint')}</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // ClientRouter swaps don't re-execute this module, so returning to the
  // page would otherwise leave a dead, unwired game board. Re-init after
  // every swap; initTowerDefenseGame no-ops on pages without a fresh root.
  import { initTowerDefenseGame } from '../../../games/towerdefense';
  initTowerDefenseGame();
  document.addEventListener('astro:after-swap', initTowerDefenseGame);
</script>

<style>
  .towerdefense-section {
    min-height: calc(100vh - var(--nav-height) - 200px);
    padding: var(--space-2xl) 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .game-container {
    max-width: 880px;
    margin: 0 auto;
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .game-header h1 {
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .td-emoji {
    animation: bannerWave 3s ease-in-out infinite;
  }

  @keyframes bannerWave {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-6deg); }
  }

  .scores {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .score-item {
    text-align: center;
  }

  .score-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .score-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: #f59e0b;
  }

  .score-value.money {
    color: #4ade80;
  }

  .score-value.lives {
    color: #f87171;
  }

  /* The run seed is reference information, not a score: it sits at the end of
     the row and is deliberately quieter than the numbers the player is playing
     for, while staying readable enough to copy down. */
  .score-value.seed {
    font-size: 1rem;
    font-weight: 600;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
  }

  .game-area {
    position: relative;
    background: var(--color-bg-secondary);
    border-radius: 1rem;
    overflow: hidden;
    border: 2px solid var(--color-border);
  }

  .canvas-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #game-canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 760 / 466;
    cursor: crosshair;
  }

  @media (max-width: 600px) {
    #game-canvas {
      min-width: 600px;
    }
  }

  .game-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  .overlay-content {
    text-align: center;
    margin: auto;
    padding: var(--space-xl);
    max-width: 560px;
  }

  .overlay-content h2 {
    margin: 0 0 var(--space-sm);
    color: #f59e0b;
  }

  .overlay-content p {
    margin: 0 0 var(--space-md);
    color: var(--color-text);
  }

  /* Standing down is a decision, not a defeat, so it gets its own colour
     rather than the campaign amber every other ending here wears. Worn by the
     confirmation heading as well as the result one, so the whole stand-down
     path reads the same from prompt to board. */
  .overlay-content h2.stood-down {
    color: #7dd3fc;
  }

  .confirm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .overlay-content .instructions {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .play-icon {
    font-size: 4rem;
    display: block;
    margin-bottom: var(--space-md);
  }

  .final-stats {
    font-size: 1.1rem;
  }

  .final-stats strong {
    color: #f59e0b;
  }

  .controls {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .tool-bar {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .tower-tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-width: 76px;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: 0.6rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.7rem;
  }

  .tower-tool:hover:not(:disabled) {
    border-color: #f59e0b;
  }

  .tower-tool.active {
    border-color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
  }

  .tower-tool:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .tool-swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    transform: rotate(45deg) scale(0.85);
  }

  .swatch-bolt {
    background: #f59e0b;
  }

  .swatch-blast {
    background: #f43f5e;
  }

  .swatch-frost {
    background: #38bdf8;
  }

  .tool-name {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
  }

  /* Stats sit under the name and cost, quieter than both: they are what the
     player reads to *choose*, not what they read to check affordability. */
  .tool-stats {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.65rem;
    color: #94a3b8;
    font-variant-numeric: tabular-nums;
  }

  .tool-stat {
    white-space: nowrap;
  }

  .tool-cost {
    color: #4ade80;
    font-size: 0.72rem;
  }

  .action-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .tower-info {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #7dd3fc;
  }

  .upgrade-btn,
  .wave-btn {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: 0.6rem;
    color: var(--color-text);
    cursor: pointer;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    transition: all 0.15s ease;
  }

  .upgrade-btn:not(:disabled):hover {
    border-color: #7dd3fc;
  }

  .wave-btn {
    min-width: 150px;
  }

  .wave-btn:not(:disabled) {
    border-color: #f59e0b;
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.35);
  }

  .upgrade-btn:disabled,
  .wave-btn:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }

  .run-controls {
    display: flex;
    align-items: center;
  }

  /* Labelled rather than iconic: ending a run has to be findable, not a
     symbol a player has to guess at. */
  .stand-down-btn {
    min-height: 44px;
    padding: 0 var(--space-md);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    background: var(--color-bg-secondary);
    border: 2px solid var(--color-border);
    border-radius: 0.6rem;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .stand-down-btn:hover:not(:disabled) {
    border-color: #7dd3fc;
    background: rgba(125, 211, 252, 0.14);
  }

  .stand-down-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .hint {
    margin-top: var(--space-sm);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 600px) {
    .game-header {
      justify-content: center;
      text-align: center;
    }

    .scores {
      justify-content: center;
      gap: var(--space-md);
    }

    .controls {
      flex-direction: column;
      align-items: stretch;
    }

    .tool-bar,
    .action-bar,
    .run-controls {
      justify-content: center;
    }
  }
</style>
