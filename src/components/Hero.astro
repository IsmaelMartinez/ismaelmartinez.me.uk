---
import { useTranslations, getLocalizedPath } from '../i18n/translations';
import { getFeaturedProjects } from '../data/projects';
import { personJsonLd } from '../data/person';

interface Props {
  lang: 'en' | 'es' | 'cat';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = getFeaturedProjects().slice(0, 3);
---

<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-headline">
        {t('hero.headline1')}<span class="hero-accent">{t('hero.headlineAccent')}</span>{t('hero.headline2')}
      </h1>
      <p class="hero-description">{t('hero.description')}</p>
      <div class="hero-actions">
        <a href={getLocalizedPath('/projects', lang)} class="btn btn-primary hero-cmd">./{t('nav.projects')}</a>
        <a href={getLocalizedPath('/writing', lang)} class="btn btn-outline hero-cmd">./{t('nav.writing')}</a>
      </div>
    </div>

    {/* The prompts are decoration; a screen reader hears only the answers. */}
    <div class="terminal">
      <div class="terminal-bar" aria-hidden="true">
        <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
        <span class="terminal-title">whoami</span>
      </div>
      <div class="terminal-body">
        <p class="terminal-cmd" aria-hidden="true"><span class="prompt">$</span> whoami</p>
        <p>{personJsonLd.name}</p>
        <p class="terminal-cmd" aria-hidden="true"><span class="prompt">$</span> cat role</p>
        <p>{t('hero.tagline')}</p>
        <p class="terminal-cmd" aria-hidden="true"><span class="prompt">$</span> ls ~/projects</p>
        <p class="terminal-ls">
          {featured.map(project => (
            <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
          ))}
        </p>
        <p class="terminal-cmd" aria-hidden="true"><span class="prompt">$</span> echo $MOTTO</p>
        <p>{t('hero.headlineAside')}<span class="cursor" aria-hidden="true"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(var(--space-2xl), 9vw, 6.5rem) 0 clamp(var(--space-2xl), 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: var(--space-2xl) 3.5rem;
    align-items: center;
  }

  .hero-headline {
    font-size: clamp(2.6rem, 5.8vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-lg);
  }

  .hero-accent {
    color: var(--color-accent);
  }

  .hero-description {
    max-width: 44ch;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero-cmd {
    text-transform: lowercase;
  }

  .terminal {
    border: 1px solid var(--color-frame);
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-md);
    border-bottom: 1px solid var(--color-frame);
    color: var(--color-text-faint);
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-frame);
  }

  .terminal-title {
    margin-left: var(--space-sm);
  }

  .terminal-body {
    padding: 1.25rem 1.375rem;
    color: var(--color-text);
  }

  .terminal-cmd {
    color: var(--color-text-muted);
  }

  .terminal-cmd:not(:first-child) {
    margin-top: 0.75rem;
  }

  .prompt {
    color: var(--color-accent);
  }

  .terminal-ls {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
  }

  .terminal-ls a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-frame);
    text-underline-offset: 3px;
  }

  .terminal-ls a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.25em;
    vertical-align: -0.2em;
    background: var(--color-accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
