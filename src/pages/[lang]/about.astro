---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import LinkCard from '../../components/LinkCard.astro';
import { useTranslations, locales } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import { socialLinks, feedLink } from '../../data/links';
import { personJsonLd, toJsonLd } from '../../data/person';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const readLinks = [{ ...feedLink, url: `/${lang}/rss.xml` }, ...socialLinks.filter(link => link.group === 'read')];
const connectLinks = socialLinks.filter(link => link.group === 'connect');

const focusAreas = [
  { icon: '🤖', title: t('about.focus1Title'), body: t('about.focus1') },
  { icon: '⚡', title: t('about.focus2Title'), body: t('about.focus2') },
  { icon: '🌍', title: t('about.focus3Title'), body: t('about.focus3') },
];

const aboutJsonLd = {
  ...personJsonLd,
  "description": t('about.description'),
  "knowsAbout": ["Software Development", "Responsible AI", "Agentic Systems", "Event-Driven Architecture", "Observability", "Cloud Architecture", "DevOps", "Open Source", "Platform Engineering", "Accessibility", "TypeScript", "JavaScript", "AWS"]
};
---

<Layout title={t('about.title')} description={t('about.description')} lang={lang}>
  <script slot="head" type="application/ld+json" set:html={toJsonLd(aboutJsonLd)} />

  <section class="section">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">{t('about.title')}</h1>
        <p class="page-description">{t('about.description')}</p>
      </header>

      <div class="about-content">
        <div class="about-section">
          <h2>{t('about.bioTitle')}</h2>
          <p>{t('about.bio')}</p>
        </div>

        <div class="about-section">
          <h2>{t('about.focusTitle')}</h2>
          <div class="grid focus-grid">
            {focusAreas.map(area => (
              <div class="card focus-card">
                <span class="focus-icon" aria-hidden="true">{area.icon}</span>
                <h3>{area.title}</h3>
                <p>{area.body}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="about-section" id="connect">
          <h2>{t('section.connect')}</h2>
          <p>{t('section.connect.description')}</p>

          <div class="link-group">
            <h3 class="group-title">{t('connect.readTitle')}</h3>
            <div class="links-list">
              {readLinks.map(link => (
                <LinkCard link={link} lang={lang} />
              ))}
            </div>
          </div>

          <div class="link-group">
            <h3 class="group-title">{t('connect.connectTitle')}</h3>
            <div class="links-list">
              {connectLinks.map(link => (
                <LinkCard link={link} lang={lang} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} />
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .page-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
  }

  .about-content {
    max-width: 800px;
  }

  .about-section {
    margin-bottom: var(--space-2xl);
  }

  .about-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .about-section > p {
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .focus-grid {
    grid-template-columns: 1fr;
  }

  .focus-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: var(--space-sm) 0;
  }

  .focus-card p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .focus-icon {
    font-size: 1.5rem;
  }

  @media (min-width: 768px) {
    .focus-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .link-group {
    margin-top: var(--space-xl);
  }

  .group-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 600px;
  }
</style>
