---
import '../styles/global.css';
import { translations, locales, defaultLang } from '../i18n/translations';

// Static hosting serves this one file for every unmatched path, so the locale
// cannot be resolved at build time. The strings for all three ship with the
// page and a small inline script picks the one matching the URL prefix,
// falling back to the default locale when the path tells us nothing.
const notFoundCopy = Object.fromEntries(
  locales.map(locale => [
    locale,
    { title: translations[locale]['notFound.title'], message: translations[locale]['notFound.message'] }
  ])
);
const fallback = notFoundCopy[defaultLang];

// Escape < the same way toJsonLd does, so a translation can never break out of
// the <script> tag it is embedded in.
const escapedCopy = JSON.stringify(notFoundCopy).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Page not found" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>{fallback.title}</title>
  </head>
  <body>
    <main class="error-page">
      <div class="container">
        <h1 class="error-code">404</h1>
        <p class="error-message" data-error-message>{fallback.message}</p>

        <nav class="locale-links" aria-label="Choose a language">
          <a href="/en/" class="btn btn-primary">English</a>
          <a href="/es/" class="btn btn-outline">Español</a>
          <a href="/cat/" class="btn btn-outline">Català</a>
        </nav>
      </div>
    </main>
    <script is:inline set:html={`(function(){
  var copy = ${escapedCopy};
  var segment = location.pathname.split('/')[1];
  if (!Object.prototype.hasOwnProperty.call(copy, segment)) return;
  document.documentElement.lang = segment;
  document.title = copy[segment].title;
  var message = document.querySelector('[data-error-message]');
  if (message) message.textContent = copy[segment].message;
})();`} />
  </body>
</html>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    background: var(--gradient-magic);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: error-float 3s ease-in-out infinite;
  }

  @keyframes error-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-code {
      animation: none;
    }
  }

  .error-message {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .locale-links {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
