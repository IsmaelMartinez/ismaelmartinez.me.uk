---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PortfolioHealthBadge from '../../components/PortfolioHealthBadge.astro';
import { useTranslations, locales, getLocalizedPath } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import { projects, externalContributions } from '../../data/projects';
import { fetchPortfolioHealth } from '../../data/health';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const health = await fetchPortfolioHealth();
---

<Layout title={t('nav.projects')} description={t('section.projects.description')} lang={lang}>
  <section class="section">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">{t('section.projects')}</h1>
        <p class="page-description">{t('section.projects.description')}</p>
        <div class="badge-row">
          <PortfolioHealthBadge health={health} lang={lang} t={t} linked={false} />
          <a href={getLocalizedPath('/health', lang)} class="health-link">{t('projects.healthLink')} →</a>
        </div>
      </header>
      <div class="grid grid-2">
        {projects.map(project => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>

      <div class="contributions">
        <h2 class="contributions-title">{t('section.contributions')}</h2>
        <p class="contributions-description">{t('section.contributions.description')}</p>
        <ul class="contributions-list">
          {externalContributions.map(contribution => (
            <li>
              <a href={contribution.url} target="_blank" rel="noopener noreferrer">{contribution.repo}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-2xl);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .page-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
  }

  .badge-row {
    margin-top: var(--space-md);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .health-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .health-link:hover {
    color: var(--color-accent);
  }

  .contributions {
    margin-top: var(--space-2xl);
  }

  .contributions-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .contributions-description {
    color: var(--color-text-muted);
    max-width: 600px;
    margin-bottom: var(--space-lg);
  }

  .contributions-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .contributions-list a {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    background: var(--color-bg-secondary);
    border: var(--frame-width) solid var(--color-frame);
    border-radius: var(--radius);
    box-shadow: var(--shadow-btn);
    text-decoration: none;
  }

  .contributions-list a:hover {
    color: var(--color-accent);
  }
</style>
